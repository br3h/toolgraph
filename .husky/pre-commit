#!/usr/bin/env sh

# 1. Secret scan — fails closed. A commit never leaves this machine with a
#    credential in it, and a missing scanner is treated as a failure, not a pass.
if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: scanning staged changes for secrets..."
  if ! gitleaks git --staged --config .gitleaks.toml --redact --no-banner --verbose; then
    echo ""
    echo "  BLOCKED: gitleaks found a possible secret in your staged changes."
    echo "  Remove the value, put it in .env.local (gitignored), and add the"
    echo "  variable name to .env.example instead."
    echo ""
    echo "  If this is definitely a false positive, add an allowlist entry to"
    echo "  .gitleaks.toml in the same commit so the exception is reviewable."
    exit 1
  fi
elif [ "$TOOLGRAPH_SKIP_GITLEAKS" = "1" ]; then
  echo "pre-commit: WARNING — secret scan skipped via TOOLGRAPH_SKIP_GITLEAKS=1."
else
  echo ""
  echo "  BLOCKED: gitleaks is not installed, so staged changes cannot be"
  echo "  scanned for secrets. This hook fails closed on purpose."
  echo ""
  echo "    macOS:  brew install gitleaks"
  echo "    Linux:  https://github.com/gitleaks/gitleaks#installing"
  echo "    Go:     go install github.com/gitleaks/gitleaks/v8@latest"
  echo ""
  echo "  To bypass once (not recommended): TOOLGRAPH_SKIP_GITLEAKS=1 git commit ..."
  echo ""
  exit 1
fi

# 2. Lint and format only the staged files.
pnpm exec lint-staged
