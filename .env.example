# ---------------------------------------------------------------------------
# toolgraph — copy to `.env.local` and fill in with your own free-tier keys.
# `.env.local` is gitignored. Never commit real values.
# Every service below has a free tier that is enough to run toolgraph locally.
# ---------------------------------------------------------------------------

# --- Supabase (auth + Postgres + storage) ---------------------------------
# Supabase dashboard -> your project -> Project Settings -> Data API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API Keys -> "Publishable key"
# (older projects call this the "anon public" key). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase dashboard -> Project Settings -> API Keys -> "Secret key"
# (older projects call this "service_role"). SERVER ONLY — bypasses Row Level
# Security. Never import this into a client component.
SUPABASE_SECRET_KEY=

# --- Upstash Redis (rate limiting, REST API) ------------------------------
# Upstash console -> your Redis database -> REST API -> UPSTASH_REDIS_REST_URL.
UPSTASH_REDIS_REST_URL=
# Same panel -> UPSTASH_REDIS_REST_TOKEN. SERVER ONLY.
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (transactional email) -----------------------------------------
# Resend dashboard -> API Keys -> Create API Key (needs "Sending access").
# SERVER ONLY.
RESEND_API_KEY=
# The verified sender, e.g. "toolgraph <noreply@yourdomain.com>". The domain must
# be verified under Resend dashboard -> Domains before real sending works.
RESEND_FROM_EMAIL=

# --- Connection credential encryption -------------------------------------
# Encrypts the Authorization headers users save with their connections, before
# those values reach the database. SERVER ONLY, and the single most sensitive
# value in this file: with it, a database dump yields every stored token; without
# it, a dump yields nothing usable.
#
# Generate one with:   openssl rand -base64 32
#
# OPTIONAL. If it is left empty, Toolgraph refuses to store connection
# credentials at all rather than storing them in a weaker form — connections
# still work, the header is typed per test and then dropped, and the UI says so.
#
# DO NOT change or rotate this on a deployment that already has stored
# credentials: existing rows are encrypted under the old key and will stop
# decrypting. Users would have to re-enter their credentials.
CREDENTIAL_ENCRYPTION_KEY=

# --- Sentry (error monitoring) --------------------------------------------
# Sentry -> your web project -> Settings -> Client Keys (DSN). Public by design.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry -> your *engine* project -> Settings -> Client Keys (DSN).
SENTRY_DSN_BACKEND=
# Sentry -> Settings -> Auth Tokens -> Create token with `project:releases`.
# Build-time only, used to upload source maps. SERVER ONLY. Optional: if this is
# empty the build still succeeds, it just skips source-map upload.
SENTRY_AUTH_TOKEN=

# --- PostHog (product analytics) ------------------------------------------
# PostHog -> Settings -> Project -> Project API Key (starts with `phc_`).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog -> Settings -> Project -> usually https://us.i.posthog.com
# or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Deployment wiring. Local defaults below work with `pnpm dev` as-is.
# ---------------------------------------------------------------------------

# Public origin of the Next.js app. Used for OAuth redirects, email links and
# the engine's CORS allowlist. Production: https://toolgraph.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public origin of the Fastify execution engine the browser talks to.
# Production: https://engine.toolgraph.dev
NEXT_PUBLIC_ENGINE_URL=http://localhost:8787

# --- Engine-only (apps/engine) --------------------------------------------
PORT=8787
# Comma-separated list of browser origins allowed to call the engine.
# Never set this to "*".
ENGINE_ALLOWED_ORIGINS=http://localhost:3000
# Set to "true" ONLY on a developer machine. It relaxes the SSRF guard so you can
# point the engine at an MCP server on localhost or a private IP. Must stay unset
# (or "false") in every deployed environment.
ENGINE_ALLOW_PRIVATE_NETWORK=false
