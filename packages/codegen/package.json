{
  "name": "@toolgraph/codegen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone TypeScript and Python code generators for toolgraph graphs. Node-only (server side).",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
